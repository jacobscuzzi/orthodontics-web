ErrorDocument 404 /404.html
Options -Indexes

<FilesMatch "^\.">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTP_HOST} ^www\.kieferorthopaediepraxis-berlin\.de$ [NC]
  RewriteRule ^ https://kieferorthopaediepraxis-berlin.de%{REQUEST_URI} [R=301,L]

  RewriteCond %{HTTP_HOST} ^kieferorthopaediepraxis-berlin\.de$ [NC]
  RewriteCond %{SERVER_PORT} !=443
  RewriteRule ^ https://kieferorthopaediepraxis-berlin.de%{REQUEST_URI} [R=301,L]

  # URLs of the old PHP site, still in search results and bookmarks
  RewriteRule ^(praxis|team|behandlung|faq|kontakt|impressum|datenschutz)\.php$ /$1/ [R=301,L,NC]
  RewriteRule ^(index|links)\.php$ / [R=301,L,NC]
  RewriteRule ^tagcloud/ / [R=301,L,NC]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <ElseIf "%{REQUEST_URI} =~ m#\.(webp|avif|jpe?g|png|gif|svg|ico)$#">
    Header set Cache-Control "public, max-age=604800"
  </ElseIf>
  <Else>
    Header set Cache-Control "no-cache"
  </Else>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/javascript application/javascript application/json image/svg+xml
</IfModule>
