---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry, getCollection, render } from 'astro:content';
import site from '../data/site.json';
import { em } from '../lib/em';
import SectionBand from '../components/SectionBand.astro';
import { withBase } from '../utils/base';

const intro = await getEntry('pages', 'team');
if (!intro) throw new Error('pages/team.md missing');
const { Content: IntroContent } = await render(intro);
const hasIntro = (intro.body ?? '').trim().length > 0;

const members = (await getCollection('team')).sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(
  members.map(async (m) => {
    const { Content } = await render(m);
    return { data: m.data, Content };
  })
);
---
<BaseLayout title={`${intro.data.title} – ${site.practice.name}`}>
  {/* Hochformat-Teamfoto: immer vollständig sichtbar (kein Zuschnitt, kein Überdecken durch Folgeinhalt). */}
  <section class="mx-auto max-w-6xl px-4 md:px-6 pt-10 md:pt-16 pb-14 md:pb-20">
    <div class="grid gap-8 md:gap-14 md:grid-cols-12 items-center">
      <div class="md:col-span-6">
        <p class="eyebrow mb-6">{intro.data.heroEyebrow ?? intro.data.title}</p>
        <h1 class="headline-xl text-text" set:html={em(intro.data.heroTitle ?? intro.data.title)} />
      </div>
      {intro.data.heroImage && (
        <figure class="md:col-span-6 flex justify-center md:justify-end">
          <div class="relative">
            <img
              src={withBase(intro.data.heroImage)}
              alt={intro.data.heroAlt ?? ''}
              class="block w-full h-auto md:w-auto md:max-h-[calc(100vh-8rem)] rounded-xl"
              loading="eager"
            />
            {intro.data.heroCredit && (
              <figcaption class="absolute bottom-3 right-4 text-sm md:text-base text-white/80 select-none drop-shadow">{intro.data.heroCredit}</figcaption>
            )}
          </div>
        </figure>
      )}
    </div>
  </section>

  <div class="relative z-10 bg-background">

  {hasIntro && (
    <section class="mx-auto max-w-3xl px-4 md:px-6 py-20 md:py-24 text-center">
      <div class="headline-md [&_p]:mb-4 [&_p:last-child]:mb-0">
        <IntroContent />
      </div>
    </section>
  )}

  {rendered.map(({ data, Content }, i) => {
    const imageLeft = i % 2 === 0;
    const band = i % 2 === 1;
    return (
      <SectionBand tone={band ? 'band' : 'background'}>
        <div class="mx-auto max-w-6xl px-4 md:px-6 py-14 md:py-20">
          <div class="grid gap-8 md:gap-14 md:grid-cols-12 items-center">
            {data.photo && (
              <div class:list={['md:col-span-5', imageLeft ? 'md:order-1' : 'md:order-2']}>
                <img
                  src={withBase(data.photo)}
                  alt={`Foto von ${data.name}`}
                  class="w-full aspect-[4/5] object-cover rounded-xl"
                  loading="lazy"
                />
              </div>
            )}
            <div class:list={['md:col-span-7', imageLeft ? 'md:order-2' : 'md:order-1']}>
              <p class="eyebrow mb-4">{`0${i + 1}`} · {data.role}</p>
              <h2 class="headline-lg mb-5">{data.name}</h2>
              <div class="prose prose-lg max-w-none text-base md:text-lg leading-relaxed opacity-90"><Content /></div>
              {data.cv && data.cv.trim() && (
                <details class="mt-6 group border-t border-primary/20 pt-4">
                  <summary class="cursor-pointer list-none flex items-center gap-2 font-medium text-primary hover:opacity-80 transition-opacity">
                    <span>{intro.data.cvToggleLabel ?? 'Lebenslauf anzeigen'}</span>
                    <span class="transition-transform group-open:rotate-180" aria-hidden="true">▾</span>
                  </summary>
                  <div class="mt-4 space-y-3 text-base leading-relaxed opacity-90">
                    {data.cv.trim().split(/\n\n+/).map((para) => (
                      <p class="whitespace-pre-line">{para.trim()}</p>
                    ))}
                  </div>
                </details>
              )}
            </div>
          </div>
        </div>
      </SectionBand>
    );
  })}
  </div>
</BaseLayout>
