---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';
import site from '../data/site.json';
import { em } from '../lib/em';
import Hero from '../components/Hero.astro';
import SectionBand from '../components/SectionBand.astro';
import { withBase } from '../utils/base';

const page = await getEntry('pages', 'praxis');
if (!page) throw new Error('pages/praxis.md missing');
const { Content } = await render(page);
const gallery = page.data.gallery ?? [];
---
<BaseLayout title={`${page.data.title} – ${site.practice.name}`}>
  <Hero
    variant="overlay"
    eyebrow={page.data.heroEyebrow ?? page.data.title}
    title={em(page.data.heroTitle ?? page.data.title)}
    image={page.data.heroImage}
    imageAlt={page.data.heroAlt}
  />

  <section class="mx-auto max-w-5xl px-4 md:px-6 py-20 md:py-28">
    <div class="prose prose-lg md:prose-xl max-w-none prose-headings:font-display prose-headings:text-primary prose-p:leading-relaxed">
      <Content />
    </div>
    <div class="mt-10 md:mt-14">
      <a
        href={withBase('/team')}
        class="inline-block bg-primary text-background px-6 py-3.5 rounded-md font-medium hover:opacity-90 transition-opacity"
      >{page.data.teamCtaLabel ?? 'Unser Team kennenlernen'}</a>
    </div>
  </section>

  {gallery.length > 0 && (
    <SectionBand tone="band">
      <div class="mx-auto max-w-6xl px-4 md:px-6 pt-20 md:pt-28">
        <div class="max-w-3xl mb-12 md:mb-16">
          {page.data.galleryEyebrow && <p class="eyebrow mb-5">{page.data.galleryEyebrow}</p>}
          <h2 class="headline-lg" set:html={em(page.data.galleryTitle ?? 'Aus unseren *Räumen*.')} />
        </div>
      </div>
      {/* Endlos laufender Filmstreifen: Fotos doppelt im Track, Animation verschiebt um genau eine Hälfte -> nahtlose Schleife.
          Dauer skaliert mit der Anzahl der Fotos (12 s pro Foto). */}
      <div class="pb-20 md:pb-28">
        <div class="gallery-marquee" style={`--marquee-duration: ${gallery.length * 12}s`}>
          <div class="gallery-track">
            {[...gallery, ...gallery].map((img, i) => (
              <img
                src={withBase(img.src)}
                alt={i < gallery.length ? (img.alt ?? '') : ''}
                aria-hidden={i >= gallery.length ? 'true' : undefined}
                class="gallery-item"
                loading="lazy"
                draggable="false"
              />
            ))}
          </div>
        </div>
      </div>
    </SectionBand>
  )}
</BaseLayout>

<style>
  .gallery-marquee {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
  }
  .gallery-track {
    --gap: 1rem;
    display: flex;
    gap: var(--gap);
    width: max-content;
    animation: gallery-scroll var(--marquee-duration, 60s) linear infinite;
    will-change: transform;
  }
  .gallery-item {
    height: 260px;
    width: auto;
    flex: 0 0 auto;
    object-fit: cover;
    user-select: none;
  }
  @media (min-width: 768px) {
    .gallery-track { --gap: 1.5rem; }
    .gallery-item { height: 420px; }
  }
  @media (min-width: 1280px) {
    .gallery-item { height: 520px; }
  }
  @keyframes gallery-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(calc(-50% - var(--gap) / 2)); }
  }
  /* Systemeinstellung "Animationen reduzieren": ruhige, seitlich wischbare Reihe ohne Duplikate */
  @media (prefers-reduced-motion: reduce) {
    .gallery-track { animation: none; width: auto; padding: 0 1rem; }
    .gallery-marquee { overflow-x: auto; -webkit-mask-image: none; mask-image: none; }
    .gallery-item[aria-hidden="true"] { display: none; }
  }
</style>
